# =============================================================================
# VIRYA CLEANTECH — Reports Automation + Site
# =============================================================================
# Copy to `.env.local` for local dev, or paste into Vercel → Settings →
# Environment Variables.  NEVER commit this file.
#
# NOTE ON SENSITIVE VALUES
# -----------------------
# VITE_* variables are inlined into the browser bundle and are therefore PUBLIC.
# That is why every secret below is un-prefixed: they stay server-side and are
# only ever read inside `/api`. Never add JIRA_API_TOKEN, GOOGLE_PRIVATE_KEY,
# RESEND_API_KEY or CRON_SECRET as VITE_ variables.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# JIRA
# ─────────────────────────────────────────────────────────────────────────────
# Site: https://harikrishnanint2027g3.atlassian.net
JIRA_BASE_URL=https://harikrishnanint2027g3.atlassian.net
JIRA_PROJECT_KEY=VCT
JIRA_LEADS_PROJECT_KEY=VCT
# Controller identifiers only; they are not authentication credentials.
JIRA_AUTOMATION_CONTROLLER=CON
JIRA_SECURITY_CONTROLLER=SEQ

# Atlassian account email used for API auth.
JIRA_EMAIL=harikrishnan.int2027g3@gmail.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
#   → Create API token → copy it once (it is only shown once).
JIRA_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# CONTROLLER AUTH
# ─────────────────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string. Keep server-side; never use VITE_ prefix.
DATABASE_URL=
# Generate each secret independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTROLLER_SESSION_SECRET=
CONTROLLER_REGISTRATION_SECRET=
# Optional separate invite key for creating admin users.
CONTROLLER_ADMIN_REGISTRATION_SECRET=

# Optional: override the default `project = VCT` JQL.
# JIRA_JQL=project = VCT AND issuetype != Sub-task

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE SHEETS  (Service Account)
# ─────────────────────────────────────────────────────────────────────────────
# 1. https://console.cloud.google.com/ → new project → enable "Google Sheets API"
# 2. IAM & Admin → Service Accounts → create one → Keys → JSON key
# 3. Paste the "client_email" and "private_key" below.
# 4. SHARE THE SPREADSHEET with that client_email as **Editor**.
#    (Sharing with your personal Gmail is NOT sufficient.)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Reports sheet id (the long id in the URL).
SHEETS_SPREADSHEET_ID=13hYacqrTMuR9QabZbLFukyhb5K6GNMZSdQZOa8ri3N4

# Tab that holds: Daily|Time|Sent Status|Weekly|...|Monthly|Time|Sent Status
SHEETS_REPORTS_TAB=Reports

# OPTIONAL: tab holding raw lead/booking rows, used for the "Leads" KPI.
# Leave blank if leads aren't tracked in a sheet yet.
SHEETS_LEADS_TAB=Leads
SHEETS_ANALYTICS_TAB=Vercel Analytics

# ─────────────────────────────────────────────────────────────────────────────
# VERCEL WEB ANALYTICS (server-side API access)
# ─────────────────────────────────────────────────────────────────────────────
# Create a dedicated Vercel access token scoped to this project and set an
# expiration. This token can control its selected scope; keep it server-
# side and never use a VITE_ prefix. VERCEL_PROJECT_ID is supplied by Vercel at
# runtime; set the analytics-specific project ID for local runs.
VERCEL_CONTROLLER=
# Legacy alias; VERCEL_CONTROLLER takes precedence when both are set.
VERCEL_ACCESS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
# Optional if the token is scoped to a team.
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# ─────────────────────────────────────────────────────────────────────────────
# SESSION TRACKING (server side)
# ─────────────────────────────────────────────────────────────────────────────
# Preferred store. Set the full Redis Cloud URL as a server-only Vercel
# environment variable. Never use the VITE_ prefix. Records expire after 90 days.
REDIS_URL=

# Optional Sheets fallback; Redis takes precedence when both stores are set.
SHEETS_SESSIONS_TAB=Sessions

# Tab holding one row per careers application. Kept separate from
# SHEETS_LEADS_TAB on purpose — a job application is not a sales lead and
# must never inflate the funnel or the daily report's lead count.
SHEETS_CAREERS_TAB=Careers

# ─────────────────────────────────────────────────────────────────────────────
# PRIVACY
# ─────────────────────────────────────────────────────────────────────────────
# India DPDP Act 2023 classifies an IP address as personal data.
#   false (default) → stores only the first two IPv4 octets, e.g. "203.0.x.x"
#                     Enough for frequency analysis, not enough to identify a
#                     household on its own.
#   true            → stores the full address. Only set this if you have a
#                     lawful basis and a written retention policy.
STORE_RAW_IP=false

# ─────────────────────────────────────────────────────────────────────────────
# JIRA — careerrouting (server side)
# ─────────────────────────────────────────────────────────────────────────────
# Where careers applications are filed. Falls back to JIRA_LEADS_PROJECT_KEY
# when blank. Either way they carry the `careers` label and never `lead`.
# JIRA_CAREERS_PROJECT_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────────────────────────────────────
# 1. https://resend.com/api-keys → Create API key
# 2. Verify your sending domain, then use reports@<your-domain> as the from.
RESEND_API_KEY=

MAIL_FROM=Virya Reports <reports@yourdomain.com>
MAIL_TO=harikrishnan.int2027g3@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Independent secret required, in addition to CRON_SECRET, for test email sends.
# Generate a different value with the command above. Never reuse CRON_SECRET.
VERCEL_SECURITY_CONTROLLER=

# Public site URL, used for absolute links in the report email.
SITE_URL=https://viryacleantech.com

# ─────────────────────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────────────────────
# The consultation form posts to same-origin `/api/leads` by default.
# Jira credentials are read server-side; no VITE key is required.
# Set VITE_LEADS_ENDPOINT only when intentionally overriding the API route.
# VITE_LEADS_ENDPOINT=/api/leads