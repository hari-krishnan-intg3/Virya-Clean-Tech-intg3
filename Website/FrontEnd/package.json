{
  "name": "viryacleantech-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "api:typecheck": "tsc -p api/tsconfig.json",
    "reports:test": "tsx scripts/run-reports.ts",
    "reports:live": "tsx scripts/run-reports.ts --live",
    "reports:verify": "tsx scripts/verify-connections.ts",
    "reports:preview-html": "tsx scripts/render-preview.ts",
    "traffic:setup": "tsx scripts/run-traffic-notification.ts",
    "traffic:notify": "tsx scripts/run-traffic-notification.ts --live",
    "traffic:playwright": "tsx scripts/test-traffic-playwright.ts",
    "leads:provision": "tsx scripts/provision-leads-project.ts",
    "leads:sync": "tsx scripts/sync-jira-leads.ts",
    "analytics:setup": "tsx scripts/setup-analytics-tab.ts",
    "sessions:setup": "tsx scripts/setup-session-tab.ts",
    "test:intent": "tsx scripts/test-intent.ts",
    "test:intelligence": "tsx --test scripts/intelligence.test.ts",
    "test:controller-auth": "tsx --test scripts/controller-auth.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.3.2",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-router-dom": "^6.30.6",
    "redis": "^6.3.0",
    "swiper": "^11.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.39",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
