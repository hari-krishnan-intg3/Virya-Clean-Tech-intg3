{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/reports?type=daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/reports?type=weekly",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/reports?type=monthly",
      "schedule": "0 8 1 * *"
    }
  ]
}